# Nuxt maps every variable to a `runtimeConfig` key: NUXT_PUBLIC_API_BASE_URL
# overrides `runtimeConfig.public.apiBaseUrl`, NUXT_AUTH_COOKIE_SECURE overrides
# `runtimeConfig.authCookieSecure`, and so on. See nuxt.config.ts.

# ─── App ──────────────────────────────────────────────────────────────────────
NUXT_PUBLIC_API_BASE_URL=http://localhost:8000
# Only when auth lives on its own host; empty falls back to the API base URL.
NUXT_AUTH_API_BASE_URL=

# ─── Auth ─────────────────────────────────────────────────────────────────────
NUXT_PUBLIC_AUTH_ENABLED=true

# Auth methods — enable the strategies your backend supports
NUXT_PUBLIC_AUTH_PASSWORD_ENABLED=true
NUXT_PUBLIC_AUTH_GOOGLE_ENABLED=false
NUXT_PUBLIC_GOOGLE_CLIENT_ID=

# ─── Auth cookies (server-only) ───────────────────────────────────────────────
NUXT_AUTH_COOKIE_DOMAIN=
NUXT_AUTH_COOKIE_SECURE=false
NUXT_AUTH_COOKIE_MAX_AGE=604800
NUXT_AUTH_COOKIE_SAMESITE=lax
