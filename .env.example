API_BASE_URL=https://api.example.com
# API de autenticación (puede ser un servicio/host distinto al de negocio).
# Si se omite, server/api/auth/* usa API_BASE_URL como fallback.
AUTH_API_BASE_URL=https://auth.example.com
JWT_SECRET=change-me-to-a-32-character-secret-key
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# Auth cookies (gestionadas por server/api/auth/*)
AUTH_COOKIE_DOMAIN=
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=lax
AUTH_ACCESS_TOKEN_MAX_AGE=900
AUTH_REFRESH_TOKEN_MAX_AGE=604800
# Path del endpoint de refresh en AUTH_API_BASE_URL. Si el backend no lo
# soporta, /api/auth/refresh degrada automáticamente a limpiar la sesión y
# forzar re-login, sin romper la app. Default: dj-rest-auth + SimpleJWT.
AUTH_REFRESH_ENDPOINT=/auth/token/refresh/
